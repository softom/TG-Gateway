[Unit]
Description=ZPR TG Web Admin (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zpr/app
# Шаблон: подставить реальный токен при деплое (secrets.env → TG_ADMIN_TOKEN), в git не коммитить.
# С пустым/слабым токеном tg_web_admin не стартует (fail-closed).
Environment=ADMIN_TOKEN=__SET_AT_DEPLOY__
ExecStart=/opt/zpr/venv/bin/uvicorn tg_web_admin:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=append:/opt/zpr/logs/web_admin.log
StandardError=append:/opt/zpr/logs/web_admin.log

[Install]
WantedBy=multi-user.target
